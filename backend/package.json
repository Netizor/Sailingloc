{
  "name": "sailingloc-backend",
  "version": "1.0.0",
  "description": "SailingLoc API – Node.js + Express + Supabase",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
