    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pg": "^8.21.0",
    "stripe": "^15.9.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
