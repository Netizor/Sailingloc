# Serveur
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase
# Dashboard → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # clé service (backend uniquement, ne jamais exposer côté front)
SUPABASE_ANON_KEY=eyJ...           # clé publique (optionnel, pour certains appels anon)

# JWT (généré par vous, indépendant de Supabase)
JWT_SECRET=changeme_minimum_32_chars_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=10

# Cloudinary (upload images bateaux)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Resend)
RESEND_API_KEY=re_...
MAIL_FROM=SailingLoc <noreply@example.com>
RESEND_TO_EMAIL=contact@example.com
CONTACT_EMAIL=contact@example.com

# Option B : SMTP classique (si Resend non utilisé)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_SECURE=false

# Push notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Pexels (scripts seed images)
PEXEL_API_KEY=your_pexels_api_key
