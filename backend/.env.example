# ─── Serveur ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Supabase ──────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # clé service (backend uniquement, ne jamais exposer côté front)
SUPABASE_ANON_KEY=eyJ...           # clé publique (optionnel, pour certains appels anon)

# ─── JWT (généré par vous, indépendant de Supabase) ────────
JWT_SECRET=changeme_minimum_32_chars_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=10

# ─── Cloudinary (upload images bateaux) ───────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Resend recommandé) ─────────────────────────────
# Option A : Resend (recommandé)
RESEND_API_KEY=re_...
# Option B : SMTP classique
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_SECURE=false
MAIL_FROM=noreply@sailingloc.fr
CONTACT_EMAIL=contact@sailingloc.fr   # adresse qui reçoit les messages du formulaire de contact

# ─── Pexels (scripts seed images destinations / bateaux) ───
PEXEL_API_KEY=your_pexels_api_key
