APP_ENV=dev
APP_SECRET=change_me_to_a_32_char_random_string_here

# Regex Nelmio (origin_regex) : autorise http(s)://localhost:PORT et 127.0.0.1 (ex. Vite :5173)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

DATABASE_URL="mysql://root:password@127.0.0.1:3306/sailingloc?serverVersion=8.0.32&charset=utf8mb4"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_jwt_passphrase
JWT_TTL=900
JWT_REFRESH_TTL=604800

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PLATFORM_FEE_PERCENT=15

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=noreply@sailingloc.fr

FRONTEND_URL=http://localhost:5173
